  }
 ],
 "caps": [
  {
   "t0": 0.128,
   "t1": 2.998,
   "text": "겨울 아침, 현관을 나서려는데 꼭 들리죠."
  },
  {
   "t0": 2.998,
   "t1": 3.904,
   "text": "모자 써!"
  },
  {
   "t0": 3.904,
   "t1": 5.344,
   "text": "열이 머리로 다 빠져나간다."
  },
  {
   "t0": 5.76,
   "t1": 8.448,
   "text": "실제로 미국 육군의 생존 교범에도 비슷한 말이 적혀"
  },
  {
   "t0": 8.448,
   "t1": 9.408,
   "text": "있었습니다."
  },
  {
   "t0": 9.408,
   "t1": 12.736,
   "text": "체온의 40에서 45퍼센트가 머리로 빠져나간다."
  },
  {
   "t0": 12.736,
   "t1": 15.168,
   "text": "그런데 이 숫자, 틀렸습니다."
  },
  {
   "t0": 15.168,
   "t1": 17.92,
   "text": "더 이상한 건, 이 숫자가 진짜 실험에서 나왔다는"
  },
  {
   "t0": 17.92,
   "t1": 21.632,
   "text": "겁니다. 결과를 옮기는 과정에서 딱 한 가지가 빠졌거든요."
  },
  {
   "t0": 21.632,
   "t1": 24.0,
   "text": "그리고 마지막엔 반전이 하나 더 있어요."
  },
  {
   "t0": 24.0,
   "t1": 26.688,
   "text": "이 잔소리가 정말로 맞는 사람들이 있거든요."
  },
  {
   "t0": 27.354,
   "t1": 28.762,
   "text": "먼저 골라 보세요."
  },
  {
   "t0": 28.762,
   "t1": 30.746,
   "text": "어른이 모자 없이 추운 데 있을 때,"
  },
  {
   "t0": 30.746,
   "t1": 32.858,
   "text": "머리로 빠져나가는 열은 얼마일까요?"
  },
  {
   "t0": 32.858,
   "t1": 34.65,
   "text": "하나, 절반 가까이."
  },
  {
   "t0": 34.65,
   "t1": 36.442,
   "text": "둘, 4분의 1 정도."
  },
  {
   "t0": 36.442,
   "t1": 38.042,
   "text": "셋, 10퍼센트 안팎."
  },
  {
   "t0": 41.234,
   "t1": 42.898,
   "text": "답은 조금 있다 공개할게요."
  },
  {
   "t0": 42.898,
   "t1": 45.906,
   "text": "그 전에 이 숫자가 어디서 왔는지부터 봐야 하거든요."
  },
  {
   "t0": 47.843,
   "t1": 51.043,
   "text": "미국 육군의 생존 교범에는 추울 때 머리를 꼭 가리라는"
  },
  {
   "t0": 51.043,
   "t1": 52.195,
   "text": "조언이 있었습니다."
  },
  {
   "t0": 52.195,
   "t1": 55.715,
   "text": "이유는 머리로 체온의 40에서 45퍼센트가 빠져나간다는"
  },
  {
   "t0": 55.715,
   "t1": 56.611,
   "text": "것이었죠."
  },
  {
   "t0": 56.611,
   "t1": 59.747,
   "text": "군대 교범에 적힌 숫자니까 누구도 의심하지 않았어요."
  },
  {
   "t0": 59.747,
   "t1": 62.179,
   "text": "이 말은 추운 나라 부모들의 잔소리가 됐고,"
  },
  {
   "t0": 62.179,
   "t1": 63.907,
   "text": "우리 집 현관까지 왔습니다."
  },
  {
   "t0": 63.907,
   "t1": 66.339,
   "text": "그럼 이 숫자는 어디서 나왔을까요?"
  },
  {
   "t0": 66.339,
   "t1": 68.003,
   "text": "이 통념을 파헤친 의사들은,"
  },
  {
   "t0": 68.003,
   "t1": 70.819,
   "text": "오래전 미군의 추위 실험을 출발점으로 봅니다."
  },
  {
   "t0": 70.819,
   "t1": 72.547,
   "text": "사람을 아주 추운 곳에 두고,"
  },
  {
   "t0": 72.547,
   "t1": 75.475,
   "text": "몸의 어디로 열이 빠져나가는지 재 본 실험이었죠."
  },
  {
   "t0": 75.475,
   "t1": 78.179,
   "text": "그런데 이 실험, 참가자들이 뭘 입고 있었는지를"
  },
  {
   "t0": 78.179,
   "t1": 80.035,
   "text": "보면 이상한 점이 하나 보입니다."
  },
  {
   "t0": 81.975,
   "t1": 85.111,
   "text": "참가자들은 북극용 생존 방한복을 입고 있었습니다."
  },
  {
   "t0": 85.111,
   "t1": 87.415,
   "text": "목부터 발끝까지 두툼하게 감싸고,"
  },
  {
   "t0": 87.415,
   "t1": 89.015,
   "text": "드러난 곳은 딱 한 군데,"
  },
  {
   "t0": 89.015,
   "t1": 90.231,
   "text": "머리뿐이었어요."
  },
  {
   "t0": 90.231,
   "t1": 92.343,
   "text": "열은 어디로든 빠져나가려고 합니다."
  },
  {
   "t0": 92.343,
   "t1": 94.519,
   "text": "모든 문을 닫고 딱 한 곳만 열어 두면,"
  },
  {
   "t0": 94.519,
   "t1": 96.439,
   "text": "당연히 그쪽으로 많이 빠지겠죠."
  },
  {
   "t0": 96.439,
   "t1": 97.975,
   "text": "열이 머리로 많이 빠진 건,"
  },
  {
   "t0": 97.975,
   "t1": 100.727,
   "text": "머리가 특별해서가 아니라 나갈 곳이 머리밖에 없었기"
  },
  {
   "t0": 100.727,
   "t1": 101.495,
   "text": "때문입니다."
  },
  {
   "t0": 102.263,
   "t1": 103.671,
   "text": "이 숫자가 왜 이상한지,"
  },
  {
   "t0": 103.671,
   "t1": 105.463,
   "text": "우리 몸으로도 확인할 수 있어요."
  },
  {
   "t0": 105.463,
   "t1": 108.087,
   "text": "정말 머리로 열의 45퍼센트가 빠진다면,"
  },
  {
   "t0": 108.087,
   "t1": 110.455,
   "text": "모자 없이 나간 날은 바지 없이 나간 날만큼 추워야"
  },
  {
   "t0": 110.455,
   "t1": 112.861,
   "text": "하잖아요. 물론 그런 일은 없죠."
  },
  {
   "t0": 112.861,
   "t1": 115.639,
   "text": "그럼 공정하게, 머리와 몸을 똑같은 조건에 두고"
  },
  {
   "t0": 115.639,
   "t1": 117.239,
   "text": "다시 재 보면 어떻게 될까요?"
  },
  {
   "t0": 119.246,
   "t1": 122.766,
   "text": "2006년, 캐나다 연구진이 이 질문을 다시 꺼냈습니다."
  },
  {
   "t0": 122.766,
   "t1": 124.174,
   "text": "이번엔 찬물이었어요."
  },
  {
   "t0": 124.174,
   "t1": 125.454,
   "text": "몸을 물에 담근 채로,"
  },
  {
   "t0": 125.454,
   "t1": 128.27,
   "text": "머리를 물 밖에 내놓기도 하고 물속에 넣기도 하면서"
  },
  {
   "t0": 128.27,
   "t1": 130.062,
   "text": "열이 빠져나가는 걸 비교했죠."
  },
  {
   "t0": 130.062,
   "t1": 131.47,
   "text": "결과는 단순했습니다."
  },
  {
   "t0": 131.47,
   "t1": 134.222,
   "text": "머리는 몸 전체 표면적의 약 7퍼센트."
  },
  {
   "t0": 134.222,
   "t1": 136.078,
   "text": "그런데 머리까지 물에 담가도,"
  },
  {
   "t0": 136.078,
   "t1": 139.15,
   "text": "전체 열 손실은 10퍼센트쯤 늘어나는 데 그쳤어요."
  },
  {
   "t0": 139.15,
   "t1": 141.774,
   "text": "머리라고 특별히 더 빠지는 게 아니었던 거죠."
  },
  {
   "t0": 141.774,
   "t1": 144.27,
   "text": "2008년에는 미국 인디애나대의 두 의사,"
  },
  {
   "t0": 144.27,
   "t1": 147.598,
   "text": "레이철 브리먼과 에런 캐럴이 영국의학저널에 이 통념을"
  },
  {
   "t0": 147.598,
   "t1": 148.558,
   "text": "정리했습니다."
  },
  {
   "t0": 148.558,
   "t1": 151.566,
   "text": "수영복만 입었다면, 머리로 잃는 열은 많아야 10퍼센트"
  },
  {
   "t0": 151.566,
   "t1": 152.014,
   "text": "정도라고요."
  },
  {
   "t0": 152.44,
   "t1": 154.382,
   "text": "그러니까 퀴즈 하나의 정답은,"
  },
  {
   "t0": 154.382,
   "t1": 156.558,
   "text": "3번! 10퍼센트 안팎입니다."
  },
  {
   "t0": 156.558,
   "t1": 158.926,
   "text": "45퍼센트와는 네 배 넘게 차이가 나죠."
  },
  {
   "t0": 159.593,
   "t1": 161.449,
   "text": "그럼 여기서 두 번째 문제."
  },
  {
   "t0": 161.449,
   "t1": 162.729,
   "text": "모자는 어떨까요?"
  },
  {
   "t0": 162.729,
   "t1": 164.393,
   "text": "하나, 쓸데없다."
  },
  {
   "t0": 164.393,
   "t1": 166.569,
   "text": "둘, 체온 지키기 1순위다."
  },
  {
   "t0": 166.569,
   "t1": 168.169,
   "text": "셋, 사람에 따라 다르다."
  },
  {
   "t0": 173.3,
   "t1": 176.564,
   "text": "여기서 \"그럼 모자 안 써도 되네\"라고 생각하면,"
  },
  {
   "t0": 176.564,
   "t1": 177.844,
   "text": "절반만 맞습니다."
  },
  {
   "t0": 177.844,
   "t1": 180.084,
   "text": "머리가 특별히 열을 많이 내보내진 않지만,"
  },
  {
   "t0": 180.084,
   "t1": 182.388,
   "text": "드러난 피부라면 어디든 열을 잃어요."
  },
  {
   "t0": 182.388,
   "t1": 184.82,
   "text": "그러니까 코트를 입고 머리만 내놓았다면,"
  },
  {
   "t0": 184.82,
   "t1": 187.29,
   "text": "그때는 머리가 정말 큰 구멍이죠."
  },
  {
   "t0": 187.29,
   "t1": 189.94,
   "text": "그리고 아까 그 찬물 실험에서 흥미로운 결과가 하나"
  },
  {
   "t0": 189.94,
   "t1": 191.028,
   "text": "더 나왔어요."
  },
  {
   "t0": 191.028,
   "t1": 192.372,
   "text": "머리를 찬물에 담그면,"
  },
  {
   "t0": 192.372,
   "t1": 194.932,
   "text": "몸 중심 온도는 훨씬 빨리 떨어졌습니다."
  },
  {
   "t0": 194.932,
   "t1": 197.236,
   "text": "빠져나간 열은 조금 늘었을 뿐인데요."
  },
  {
   "t0": 197.236,
   "t1": 200.308,
   "text": "연구진은 머리와 얼굴이 차가워지면 몸이 피의 흐름을"
  },
  {
   "t0": 200.308,
   "t1": 201.908,
   "text": "바꾸기 때문일 거라고 봤어요."
  },
  {
   "t0": 201.908,
   "t1": 205.108,
   "text": "그러니까 결론은, 모자만 특별한 게 아니라 모자도"
  },
  {
   "t0": 205.108,
   "t1": 207.924,
   "text": "장갑도 목도리도 다 쓸모가 있다는 겁니다."
  },
  {
   "t0": 207.924,
   "t1": 210.292,
   "text": "그런데 이 잔소리가 정말로,"
  },
  {
   "t0": 210.292,
   "t1": 212.148,
   "text": "글자 그대로 맞는 사람들이 있습니다."
  },
  {
   "t0": 214.221,
   "t1": 216.781,
   "text": "아기가 태어나면 병원에서 가장 먼저 하는 일 중"
  },
  {
   "t0": 216.781,
   "t1": 219.085,
   "text": "하나, 작은 모자를 씌워 주는 거예요."
  },
  {
   "t0": 219.085,
   "t1": 220.941,
   "text": "이건 귀여워서가 아닙니다."
  },
  {
   "t0": 220.941,
   "t1": 223.245,
   "text": "신생아는 몸에 비해 머리가 크거든요."
  },
  {
   "t0": 223.245,
   "t1": 226.701,
   "text": "그래서 머리로 잃는 열의 비중이 어른보다 훨씬 큽니다."
  },
  {
   "t0": 226.701,
   "t1": 229.325,
   "text": "게다가 몸무게에 비해 피부 면적이 어른의 세 배"
  },
  {
   "t0": 229.325,
   "t1": 231.693,
   "text": "가까이라, 열을 훨씬 빨리 잃어요."
  },
  {
   "t0": 231.693,
   "t1": 235.021,
   "text": "1981년, 영국의 한 소아과 학술지에 실린 연구는"
  },
  {
   "t0": 235.021,
   "t1": 237.773,
   "text": "갓 태어난 아기 13명으로 이걸 재 봤습니다."
  },
  {
   "t0": 237.773,
   "t1": 239.181,
   "text": "솜을 덧댄 모자를 씌우니,"
  },
  {
   "t0": 239.181,
   "t1": 242.573,
   "text": "아기가 잃는 열이 벗었을 때의 75퍼센트로 줄었어요."
  },
  {
   "t0": 242.573,
   "t1": 245.325,
   "text": "재미있는 건, 비슷한 재료로 만든 띠를 배에 둘렀을"
  },
  {
   "t0": 245.325,
   "t1": 247.309,
   "text": "때는 효과가 없었다는 겁니다."
  },
  {
   "t0": 247.309,
   "t1": 249.421,
   "text": "얇은 붕대 모자도 효과가 없었고요."
  },
  {
   "t0": 249.421,
   "t1": 251.789,
   "text": "아기에게는 정말로 머리가 큰 구멍이고,"
  },
  {
   "t0": 251.789,
   "t1": 253.709,
   "text": "그걸 제대로 막아야 한다는 뜻이죠."
  },
  {
   "t0": 253.709,
   "t1": 255.949,
   "text": "그러니까 퀴즈 둘의 정답은 3번,"
  },
  {
   "t0": 255.949,
   "t1": 257.293,
   "text": "사람에 따라 다릅니다!"
  },
  {
   "t0": 257.293,
   "t1": 258.701,
   "text": "어른에게는 과장이었고,"
  },
  {
   "t0": 258.701,
   "t1": 260.109,
   "text": "아기에게는 정답이었어요."
  },
  {
   "t0": 260.774,
   "t1": 261.926,
   "text": "정리해 볼게요."
  },
  {
   "t0": 261.926,
   "t1": 265.702,
   "text": "첫째, 머리로 체온 절반이 빠진다는 숫자는 틀렸습니다."
  },
  {
   "t0": 265.702,
   "t1": 269.158,
   "text": "둘째, 그 숫자는 머리만 내놓은 실험에서 나왔어요."
  },
  {
   "t0": 269.158,
   "t1": 271.398,
   "text": "셋째, 그래도 모자는 쓰는 게 좋고,"
  },
  {
   "t0": 271.398,
   "t1": 273.318,
   "text": "아기에게는 꼭 필요합니다."
  },
  {
   "t0": 273.318,
   "t1": 276.198,
   "text": "같은 모자인데, 누구에게는 상식이 틀리고 누구에게는"
  },
  {
   "t0": 276.198,
   "t1": 277.326,
   "text": "맞았던 거죠."
  },
  {
   "t0": 277.326,
   "t1": 279.526,
