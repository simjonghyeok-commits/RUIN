   "title": "3. 진짜 숫자"
  },
  {
   "t": 171.708,
   "dur": 1.4,
   "title": "4. 반전 ①: 그래도 모자"
  },
  {
   "t": 212.693,
   "dur": 1.4,
   "title": "5. 반전 ②: 신생아 모자"
  }
 ],
 "think": [
  {
   "t": 38.106,
   "dur": 3.0
  },
  {
   "t": 168.108,
